# Optional provider configuration for LLM-generated responses.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set a long, random value for any non-demo deployment.
# Required when ENVIRONMENT=production.
ENVIRONMENT=development
JWT_SECRET_KEY=
SESSION_EXPIRE_MINUTES=480
